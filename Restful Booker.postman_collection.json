                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n})\r\n\r\npm.test(\"First name and last name are similar?\",function() {\r\n    let jsonData = pm.response.json();\r\n    let firstName = pm.environment.get('firstName')\r\n    pm.expect(jsonData.firstname).to.eql(firstName);\r\n})\r\n\r\npm.test(\"Last name are similar?\",function() {\r\n    let jsonData = pm.response.json();\r\n    let lastName = pm.environment.get('lastName')   \r\n    pm.expect(jsonData.lastname).to.eql(lastName);\r\n})\r\n\r\npm.test(\"The dates are in reservation?\", function(){\r\n    let bookingDates = pm.response.json().bookingdates\r\n    pm.expect(bookingDates.checkin).to.not.eql(null);\r\n    pm.expect(bookingDates.checkout).to.not.eql(null);\r\n})"
